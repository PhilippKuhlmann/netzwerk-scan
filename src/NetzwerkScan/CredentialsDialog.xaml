<Window x:Class="NetzwerkScan.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anmelden" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource CardBrush}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <StackPanel Margin="18,16">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,14"
                   Text="Das Passwort wird nicht gespeichert. Die Anmeldung gilt, bis die Anwendung geschlossen wird."/>

        <TextBlock Text="Benutzername" Margin="0,0,0,3"/>
        <TextBox x:Name="UserBox" AutomationProperties.Name="Benutzername"/>
        <TextBlock Style="{StaticResource MutedText}" Text="Bei Bedarf mit Gerätename: NAS\admin" Margin="0,3,0,10"/>

        <TextBlock Text="Passwort" Margin="0,0,0,3"/>
        <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Passwort"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Abbrechen" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/>
            <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="Anmelden" IsDefault="True" Padding="14,6" Click="Login_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
