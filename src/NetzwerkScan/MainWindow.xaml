<Window x:Class="NetzwerkScan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Netzwerk-Scan" Width="1320" Height="840" MinWidth="1200" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scan settings -->
        <Border Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Netzwerkkarte"/>
                <ComboBox x:Name="AdapterCombo" Grid.Column="1" ItemsSource="{Binding Adapters}"
                          SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Text"
                          DropDownOpened="AdapterCombo_DropDownOpened" DropDownClosed="AdapterCombo_DropDownClosed"
                          AutomationProperties.Name="Netzwerkkarte"/>

                <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Bereich" Margin="16,0,8,0"/>
                <TextBox Grid.Column="3" Width="260" Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Zum Beispiel 192.168.1.0/24, 192.168.1.10-50 oder 192.168.1.10. Mehrere mit Komma trennen."
                         AutomationProperties.Name="Bereich"/>

                <Button Grid.Column="4" Grid.RowSpan="2" Margin="16,0,0,0" Style="{StaticResource SecondaryButton}"
                        FontSize="13" Padding="12,4" Click="Settings_Click"
                        AutomationProperties.Name="Einstellungen" AutomationProperties.AutomationId="SettingsButton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,7,0"/>
                        <TextBlock Text="Einstellungen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" Grid.RowSpan="2" Margin="8,0,0,0" MinWidth="130"
                        Command="{Binding ToggleScanCommand}" AutomationProperties.AutomationId="ScanButton">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Scan starten"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Content" Value="Stopp"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3,0,0" TextAlignment="Right" HorizontalAlignment="Right"
                           FontSize="12" Text="{Binding RangeInfo}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RangeHasError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="1" Grid.Column="1" Margin="1,3,0,0" HorizontalAlignment="Left" Text="{Binding ScanSummary}"
                           AutomationProperties.AutomationId="ScanSummary">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScanSettingsInvalid}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Overview -->
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12,5">
                <DockPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding FoundText}" AutomationProperties.AutomationId="FoundText"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Adressen belegt" FontSize="12"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding FreeText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,5">
                <DockPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding HostsWithPorts}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Geräte mit offenen Ports" FontSize="12"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding OpenPortsText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12,5">
                <DockPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding WebCount}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Weboberflächen" FontSize="12"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding WebHostsText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Card}" Padding="12,5">
                <DockPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding ShareCount}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Windows-Freigaben" FontSize="12"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding ShareHostsText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Hosts and details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="360" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Suchen"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Aufwecken…" Margin="8,0,0,0"
                                    FontSize="13" Padding="12,4" Click="Wake_Click"
                                    ToolTip="Bekannte Geräte, die gerade aus sind, per Wake-on-LAN starten"
                                    AutomationProperties.AutomationId="WakeButton"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Exportieren" Margin="8,0,0,0"
                                    FontSize="13" Padding="12,4" Click="Export_Click" IsEnabled="{Binding CanExport}"
                                    ToolTip="Ergebnis als CSV-Datei speichern, zum Beispiel für Excel"
                                    AutomationProperties.AutomationId="ExportButton"/>
                        </StackPanel>
                        <TextBlock Text="Suchen nach IP, Name, Hersteller, Port oder Freigabe" Margin="9,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- What changed since the previous scan -->
                    <StackPanel Grid.Row="1" Margin="13,0,12,10"
                                Visibility="{Binding ChangeSummary, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding ChangeSummary}"
                                   AutomationProperties.AutomationId="ChangeSummary"/>
                        <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding MissingDevices}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MissingChip}" Command="{Binding WakeCommand}" IsEnabled="{Binding CanWake}"
                                                ToolTip="{Binding ToolTipText}" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="{Binding Text}">
                                            <TextBlock FontSize="12" Text="{Binding Text}" TextDecorations="Strikethrough"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <DataGrid x:Name="HostGrid" Grid.Row="2" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                              SelectionMode="Single" SelectionUnit="FullRow" BorderThickness="0" Background="Transparent"
                              EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="HostGrid">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="IP-Adresse kopieren" Click="CopyIp_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSofterBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="Transparent" Padding="10,6">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- The built-in cell style turns text white on selection. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="IP-Adresse" SortMemberPath="IpKey" Width="150" ClipboardContentBinding="{Binding Ip}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Ip}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource NewBadge}" Margin="6,0,0,0"
                                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Text="NEU" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NewBadgeTextBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="140" ElementStyle="{StaticResource TrimmedCell}"/>
                            <DataGridTemplateColumn Header="Hersteller" Width="140" SortMemberPath="VendorShort" ClipboardContentBinding="{Binding Vendor}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource TrimmedCell}" Text="{Binding VendorShort}" ToolTip="{Binding VendorToolTip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" Width="68"/>
                            <DataGridTemplateColumn Header="Ports (blau Web, lila SSH, orange RDP)" Width="*" SortMemberPath="Ports.Count">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Ports}" ItemsPanel="{StaticResource WrapItems}"
                                                      ItemTemplate="{StaticResource PortChipTemplate}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Freigaben" Width="130" SortMemberPath="VisibleShareCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SharesSummary}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsLogin}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{Binding EmptyHintText}" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisible}}"/>
                </Grid>
            </Border>

            <!-- Details of the selected device -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Gerät in der Liste auswählen, um Details zu sehen." Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"
                               Visibility="{Binding SelectedHost, Converter={StaticResource NullToVisible}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedHost, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel DataContext="{Binding SelectedHost}" Margin="16,14">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Ip}"/>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding Name, Converter={StaticResource NullToCollapsed}}"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Subtitle}" Margin="0,2,0,0"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding AnnouncedText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding AnnouncedText, Converter={StaticResource NullToCollapsed}}"
                                       AutomationProperties.AutomationId="AnnouncedText"/>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Eigener Name"/>
                            <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                                     LostKeyboardFocus="CustomName_LostFocus" KeyDown="CustomName_KeyDown"
                                     ToolTip="Wird in der Liste angezeigt und bleibt auf diesem PC gespeichert."
                                     AutomationProperties.Name="Eigener Name" AutomationProperties.AutomationId="CustomName"/>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Weboberflächen"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Keine gefunden."
                                       Visibility="{Binding ShowNoWebHint, Converter={StaticResource BoolToVisible}}"/>
                            <ItemsControl ItemsSource="{Binding WebPorts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="{Binding WebTitle}" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Url}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Öffnen"
                                                    VerticalAlignment="Center" Command="{Binding OpenCommand}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Offene Ports"/>
                            <ItemsControl ItemsSource="{Binding Ports}" ItemsPanel="{StaticResource WrapItems}"
                                          ItemTemplate="{StaticResource PortChipTemplate}"/>

                            <StackPanel Visibility="{Binding HasSmb, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Windows-Freigaben"/>
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding ShareMessage}" Margin="0,0,0,6"
                                           Visibility="{Binding ShareMessage, Converter={StaticResource NullToCollapsed}}"/>
                                <ItemsControl ItemsSource="{Binding Shares}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Detail}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Öffnen"
                                                        VerticalAlignment="Center" Command="{Binding OpenCommand}"
                                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisible}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource SecondaryButton}" Content="Mit Benutzerkonto anmelden…"
                                        HorizontalAlignment="Left" Click="Login_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Progress -->
        <Grid Grid.Row="3" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="StatusText"/>
            <ProgressBar Grid.Column="1" Style="{StaticResource ScanProgress}" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" Margin="10,0,0,0" MinWidth="36" TextAlignment="Right"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>        </Grid>
    </Grid>
</Window>
