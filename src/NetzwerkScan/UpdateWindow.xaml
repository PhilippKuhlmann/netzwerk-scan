<Window x:Class="NetzwerkScan.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource CardBrush}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <StackPanel Margin="18,16">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                   Text="Wird heruntergeladen und installiert. Die Anwendung startet danach neu."/>
        <ProgressBar x:Name="Bar" Style="{StaticResource ScanProgress}" Minimum="0" Maximum="1"/>
        <Button Style="{StaticResource SecondaryButton}" Content="Überspringen" HorizontalAlignment="Right" Margin="0,16,0,0"
                IsCancel="True" Padding="14,6" AutomationProperties.AutomationId="SkipUpdate"/>
    </StackPanel>
</Window>
