<Window x:Class="NetzwerkScan.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource CardBrush}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <StackPanel Margin="20,6,20,18">
        <TextBlock Style="{StaticResource SectionTitle}" Text="Ports"/>
        <CheckBox Content="Offene Ports scannen" IsChecked="{Binding ScanPorts}" HorizontalAlignment="Left"/>

        <StackPanel IsEnabled="{Binding ScanPorts}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PortsInfo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PortsHaveError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                                <!-- With port scanning off the selection doesn't matter, so neither does its error. -->
                                <DataTrigger Binding="{Binding ScanPorts}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Standard" Margin="8,0,0,0"
                        Command="{Binding SelectStandardPortsCommand}"/>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Nur Web" Margin="6,0,0,0"
                        Command="{Binding SelectWebPortsCommand}"/>
                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Keine" Margin="6,0,0,0"
                        Command="{Binding ClearPortsCommand}"/>
            </Grid>

            <Border Margin="0,6,0,0" Height="290" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource InputLineBrush}" Background="{DynamicResource InputBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" AutomationProperties.AutomationId="PortList">
                    <ItemsControl ItemsSource="{Binding PortGroups}" Margin="10,2,6,8" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,3"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="{Binding Port, StringFormat=Port {0}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Port}" Width="46" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Weitere Ports"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="Zum Beispiel 12345,8000-8100. Alle: 1-65535, dauert lange."/>
                </StackPanel>
                <TextBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                         Text="{Binding ExtraPortsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weitere Ports"/>
            </Grid>
        </StackPanel>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Timeout pro Port (ms)"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="Bei langsamen oder gerouteten Netzen höher stellen."/>
            </StackPanel>
            <TextBox Grid.Column="1" Width="70" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Timeout"/>
        </Grid>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource ErrorBrush}"
                   Text="{Binding TimeoutRangeText}" Visibility="{Binding TimeoutHasError, Converter={StaticResource BoolToVisible}}"/>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SSH-Benutzer"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="Für Klicks auf Port 22. Leer: root."/>
            </StackPanel>
            <TextBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="{Binding SshUser, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SSH-Benutzer"/>
        </Grid>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource ErrorBrush}"
                   Text="Nur Buchstaben, Ziffern, Punkt, Bindestrich und Unterstrich"
                   Visibility="{Binding SshUserHasError, Converter={StaticResource BoolToVisible}}"/>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Windows-Freigaben"/>
        <CheckBox Content="Freigaben suchen" IsChecked="{Binding FindShares}" HorizontalAlignment="Left"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="21,3,0,0"
                   Text="Meldet sich bei jedem SMB-Gerät mit deinem Windows-Konto an, wie der Explorer. In fremden Netzen besser ausschalten."/>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Darstellung"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Design" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                      DisplayMemberPath="Text" AutomationProperties.Name="Design"/>
        </Grid>

        <Grid Margin="0,20,0,0">
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding VersionText}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="VersionText"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Fertig" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Padding="20,6" AutomationProperties.AutomationId="SettingsDone"/>
        </Grid>
    </StackPanel>
</Window>
